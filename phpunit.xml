<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Herd CLI defaults to 128M; long-lived parallel workers plus zipstream's 16 MB
             read buffer (Excel exports) can exceed it. Production uses 256M (docker/app/php.ini). -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="ruangkerja_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="GOOGLE_FAKE" value="true"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="EMPLOYEE_DEFAULT_PASSWORD" value="" force="true"/>
        <!-- Video RuangKerja, notulen otomatis, collab: never from a developer's .env (tests configure them explicitly). -->
        <env name="LIVEKIT_URL" value="" force="true"/>
        <env name="LIVEKIT_API_URL" value="" force="true"/>
        <env name="LIVEKIT_API_KEY" value="" force="true"/>
        <env name="LIVEKIT_API_SECRET" value="" force="true"/>
        <env name="LIVEKIT_SUBTITLES" value="false" force="true"/>
        <env name="TRANSCRIBER_URL" value="" force="true"/>
        <env name="TRANSCRIBER_SECRET" value="" force="true"/>
        <env name="TRANSCRIBER_CALLBACK_SECRET" value="" force="true"/>
        <env name="MINUTES_LLM_API_KEY" value="" force="true"/>
        <env name="COLLAB_SECRET" value="" force="true"/>
    </php>
</phpunit>
