APP_NAME=RuangKerja
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://ruangkerja.test
APP_TIMEZONE=UTC
OFFICE_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Branding (config/branding.php). BRANDING_LOGO kosong = inisial "RK".
BRANDING_COMPANY_NAME="[Nama Perusahaan]"
BRANDING_LOGO=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Login demo tanpa Google (HANYA lokal)
DEMO_LOGIN_ENABLED=true
# Kata sandi bawaan karyawan (rahasia, jangan di-commit). Kosong = fitur mati.
# Diisi: karyawan baru (form & impor) langsung bisa login dengan sandi ini dan wajib
# menggantinya saat login pertama; HR bisa memilih "Sandi bawaan" di Atur kata sandi.
# Super Admin tidak pernah mendapatkannya. Reset massal: php artisan ruangkerja:reset-default-passwords
EMPLOYEE_DEFAULT_PASSWORD=
# Fase 2 & 3 front-end previews at /pratinjau (sample data, saves nothing)
FEATURE_PROTOTYPE=true
# Obrolan (F2-1): /obrolan + tile Dock. Produksi: nyalakan saat rilis, setelah chat:sync-workspace-channels.
FEATURE_CHAT=true
# Dashboard per jabatan (F3): /peran/{peran} + tile Dock. HR memetakan jabatan di Admin > Organisasi > Jabatan.
FEATURE_ROLE_DASHBOARDS=true
# OKR divisi (F3-3): /okr + tile Dock/Rail + baris Menu.
FEATURE_OKR=true
# Otomasi + Kinerja saya (F2-4): /otomasi, /otomasi/berulang, /otomasi/template, /kinerja + tile Dock.
FEATURE_AUTOMATION=true
# Catatan bersama (F2-2): /catatan + tile Dock.
FEATURE_NOTES=true
# Server kolaborasi catatan (collab/, Hocuspocus). Kosongkan COLLAB_SECRET = mode simpan tanpa kolaborasi.
# Isi rahasia acak >= 32 karakter, mis. `php -r "echo bin2hex(random_bytes(32));"`.
COLLAB_SECRET=
COLLAB_PORT=1234
# Laravel -> server kolaborasi (HTTP internal) dan browser -> server kolaborasi (WebSocket).
COLLAB_URL=http://127.0.0.1:1234
VITE_COLLAB_URL=ws://127.0.0.1:1234
# Rapat, notulen & kalender (F2-3): /rapat, /kalender, /manajemen/jadwal + tile Dock.
FEATURE_MEETINGS=true
# Video RuangKerja (LiveKit, docs/SETUP-LOKAL.md "Rapat video"). Kosong = pilihan "Video RuangKerja" disembunyikan.
# Lokal: `docker compose --profile video up -d livekit` + `herd proxy livekit http://127.0.0.1:7880 --secure`, lalu:
# LIVEKIT_URL=wss://livekit.test
# LIVEKIT_API_URL=http://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=ruangkerja-livekit-dev-secret-0123456789
# Subtitle langsung di ruang rapat (tahap 2, server transkripsi GPU). Bawaan mati.
LIVEKIT_SUBTITLES=false
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Observabilitas (opsional). Kosong = Sentry nonaktif.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Proxy tepercaya yang boleh mengirim X-Forwarded-* (IP/CIDR dipisah koma, atau *).
# Tidak diisi = 127.0.0.1, ::1 dan rentang privat (config/trustedproxy.php); diisi kosong = tidak ada.
# Produksi: rentang privat Docker (lihat .env.production.example).
# TRUSTED_PROXIES=

# PostgreSQL dari docker compose
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_FORWARD_PORT=5432
DB_DATABASE=ruangkerja
DB_USERNAME=ruangkerja
DB_PASSWORD=secret

# Redis dari docker compose
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_FORWARD_PORT=6379
REDIS_PASSWORD=null
MEMCACHED_HOST=127.0.0.1

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS-only session cookie. Must be true in production (and on https://ruangkerja.test).
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
FILESYSTEM_PRIVATE_DISK=local

# Mailpit (UI: http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FORWARD_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ruangkerja.test"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb (WebSocket) lokal
REVERB_APP_ID=ruangkerja
REVERB_APP_KEY=ruangkerja-local-key
REVERB_APP_SECRET=ruangkerja-local-secret
# Lokal: host situs Herd yang sudah `herd secure` → Reverb otomatis memakai
# sertifikat Herd (wss). Halaman HTTPS selalu memaksa wss, jadi jangan pakai localhost/http.
REVERB_HOST=ruangkerja.test
REVERB_PORT=8080
# Port server Reverb (reverb:start). Samakan dengan REVERB_PORT di lokal.
REVERB_SERVER_PORT=8080
REVERB_SCHEME=https
# Host yang boleh membuka WebSocket (produksi: domain aplikasi).
REVERB_ALLOWED_ORIGINS=*
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"

# Google Workspace (isi sendiri, jangan di-commit). Kosong = fitur Google nonaktif + pesan ramah.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_ALLOWED_DOMAIN=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_USER=
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_SHARED_DRIVE_NAME=RuangKerja
GOOGLE_PICKER_API_KEY=
# Opsional: nomor proyek Cloud untuk Picker (bawaan: diambil dari GOOGLE_CLIENT_ID).
GOOGLE_PICKER_APP_ID=
# Redirect OAuth "Hubungkan akun Google" (Picker). Daftarkan juga di OAuth client.
GOOGLE_DRIVE_REDIRECT_URI="${APP_URL}/google/connect/callback"
# Email (pisah koma) yang izin langsungnya di folder workspace tidak pernah dicabut sinkron.
GOOGLE_PROTECTED_EMAILS=
# true = Drive palsu tanpa Google (hanya lokal/test; diabaikan di produksi).
GOOGLE_FAKE=false

# Absensi
ATTENDANCE_QR_SECRET=
# true = scan QR tanpa GPS ditolak; false = diterima tetapi ditandai "QR tanpa lokasi GPS" untuk ditinjau HR.
ATTENDANCE_QR_REQUIRE_LOCATION=false
ATTENDANCE_SELFIE_RETENTION_MONTHS=12
# Kebijakan privasi (resources/markdown/privacy-policy.md, config/privacy.php). Naikkan versinya bila
# teksnya berubah: semua karyawan diminta menyetujui ulang sebelum check-in GPS + selfie berikutnya.
PRIVACY_POLICY_VERSION=1.0
PRIVACY_POLICY_DATE=2026-10-05
PRIVACY_CONTACT="tim HR"
# Opsional: versi persetujuan absensi terpisah (default = PRIVACY_POLICY_VERSION).
# ATTENDANCE_CONSENT_VERSION=1.0
# Disk selfie: local (dev) atau s3 (produksi, object storage privat).
ATTENDANCE_SELFIE_DRIVER=local
ATTENDANCE_SELFIE_BUCKET=

# Object storage S3-compatible (selfie, lampiran privat, backup)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Hiring: hari data pelamar disimpan setelah keputusan / dihapus / lowongan ditutup (keputusan pemilik 6 Okt 2026).
HIRING_RETENTION_DAYS=30
