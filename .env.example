APP_NAME=RuangKerja
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://ruangkerja.test
APP_TIMEZONE=UTC
OFFICE_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Login demo tanpa Google (HANYA lokal)
DEMO_LOGIN_ENABLED=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL dari docker compose
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_FORWARD_PORT=5432
DB_DATABASE=ruangkerja
DB_USERNAME=ruangkerja
DB_PASSWORD=secret

# Redis dari docker compose
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_FORWARD_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=redis
SESSION_LIFETIME=480
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
FILESYSTEM_PRIVATE_DISK=local

# Mailpit (UI: http://localhost:8025)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FORWARD_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ruangkerja.test"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb (WebSocket) lokal
REVERB_APP_ID=ruangkerja
REVERB_APP_KEY=ruangkerja-local-key
REVERB_APP_SECRET=ruangkerja-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"

# Google Workspace (isi sendiri, jangan di-commit). Kosong = fitur Google nonaktif + pesan ramah.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_ALLOWED_DOMAIN=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATE_USER=
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_PICKER_API_KEY=

# Absensi
ATTENDANCE_QR_SECRET=
ATTENDANCE_SELFIE_RETENTION_MONTHS=12
