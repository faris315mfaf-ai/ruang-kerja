{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php -v)",
      "Bash(php -m)",
      "Bash(php artisan *)",
      "Bash(composer install)",
      "Bash(composer run *)",
      "Bash(composer test *)",
      "Bash(composer lint *)",
      "Bash(composer dump-autoload *)",
      "Bash(./vendor/bin/pest *)",
      "Bash(./vendor/bin/pint *)",
      "Bash(./vendor/bin/phpstan *)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx vitest *)",
      "Bash(node -v)",
      "Bash(npm -v)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose up -d *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose exec *)",
      "Bash(herd *)",
      "Bash(curl -I *)",
      "Bash(curl -s *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(composer require *)",
      "Bash(composer remove *)",
      "Bash(composer update *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(php artisan migrate:fresh *)",
      "Bash(php artisan migrate:reset *)",
      "Bash(php artisan db:wipe *)",
      "Bash(docker compose down *)",
      "Bash(git reset *)",
      "Bash(git rebase *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./storage/app/private/**)",
      "Read(./secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
