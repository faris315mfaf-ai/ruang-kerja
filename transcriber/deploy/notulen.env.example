# /opt/livekit/notulen.env (chmod 600) — never commit the real values.
TRANSCRIBER_SECRET=<sama dengan TRANSCRIBER_SECRET aplikasi, openssl rand -hex 32>
TRANSCRIBER_APP_URL=https://spkd.store
TRANSCRIBER_IMAGE=ghcr.io/<org>/ruangkerja-transcriber:latest
WHISPER_MODEL=large-v3-turbo
WHISPER_CPU_THREADS=4
TRANSCRIBER_CPUS=4
