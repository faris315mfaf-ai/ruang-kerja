includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 8

    # Berkas konfigurasi & migrasi yang diterbitkan paket pihak ketiga (bukan kode kita).
    excludePaths:
        - config/horizon.php
        - config/pulse.php
        - database/migrations/*_create_pulse_tables.php
